{
	"name": "pl_bronze_ingestion_dummy",
	"properties": {
		"description": "Version 1.1 - CI/CD Test",
		"activities": [
			{
				"name": "copy_json_to_parquet",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "Source",
						"value": "bronze/products/products.json"
					},
					{
						"name": "Destination",
						"value": "bronze/products/"
					}
				],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "FlattenHierarchy"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "$['id']"
								},
								"sink": {
									"name": "id"
								}
							},
							{
								"source": {
									"path": "$['name']"
								},
								"sink": {
									"name": "name"
								}
							},
							{
								"source": {
									"path": "$['category']"
								},
								"sink": {
									"name": "category"
								}
							},
							{
								"source": {
									"path": "$['price']"
								},
								"sink": {
									"name": "price"
								}
							}
						],
						"mapComplexValuesToString": false
					}
				},
				"inputs": [
					{
						"referenceName": "ds_source_products_json",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_bronze_products_parquet",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "df_bronze_to_silver_du",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "copy_json_to_parquet",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "df_bronze_to_silver_du",
						"type": "DataFlowReference"
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			},
			{
				"name": "df_silver_to_gold",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "df_bronze_to_silver_du",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "df_silver_to_gold",
						"type": "DataFlowReference"
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			},
			{
				"name": "on_failure",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "copy_json_to_parquet",
						"dependencyConditions": [
							"Failed"
						]
					},
					{
						"activity": "df_bronze_to_silver_du",
						"dependencyConditions": [
							"Failed"
						]
					},
					{
						"activity": "df_silver_to_gold",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": "https://httpbin.org/post",
					"body": {
						"status": "FAILED",
						"pipeline": "master"
					}
				}
			}
		],
		"annotations": []
	}
}