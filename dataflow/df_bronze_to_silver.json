{
	"name": "df_bronze_to_silver",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_source_products_json",
						"type": "DatasetReference"
					},
					"name": "bronzeproducts"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_bronze_products_parquet",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "ls_adls_ecommerce",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          id as integer,",
				"          name as string,",
				"          category as string,",
				"          price as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'arrayOfDocuments') ~> bronzeproducts",
				"bronzeproducts sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          total as long,",
				"          skip as long,",
				"          limit as long",
				"     ),",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}