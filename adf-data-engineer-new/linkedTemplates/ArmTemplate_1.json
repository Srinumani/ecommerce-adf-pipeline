						"aggregate2 filter(salary>=20000) ~> filter1",
						"filter1 sort(asc(salary, true),",
						"     caseInsensitive: true) ~> sort1",
						"filter2 aggregate(groupBy(emp_id,",
						"          name,",
						"          salary,",
						"          address,",
						"          loc,",
						"          email),",
